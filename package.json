{
  "name": "vfm-preview",
  "displayName": "VFM Preview",
  "description": "Preview Markdown files using the custom vfm parser/renderer.",
  "version": "0.1.0",
  "publisher": "victor",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vfmPreview.open",
        "title": "VFM: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "vfmPreview.openToSide",
        "title": "VFM: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "vfmPreview.toggleMode",
        "title": "VFM: Toggle Document / Slide Mode"
      },
      {
        "command": "vfmPreview.showSlides",
        "title": "VFM: Show as Slides",
        "icon": "$(play-circle)"
      },
      {
        "command": "vfmPreview.showDocument",
        "title": "VFM: Show as Document",
        "icon": "$(book)"
      },
      {
        "command": "vfmPreview.exportHtml",
        "title": "VFM: Export to HTML…"
      },
      {
        "command": "vfmPreview.exportPdf",
        "title": "VFM: Export to PDF…"
      },
      {
        "command": "vfmPreview.openInBrowser",
        "title": "VFM: Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "vfmPreview.exportWord",
        "title": "VFM: Export to Word… (optional docx-template in YAML header)"
      },
      {
        "command": "vfmPreview.exportPowerPoint",
        "title": "VFM: Export Slides to PowerPoint… (optional pptx-template in YAML header)"
      },
      {
        "command": "vfmPreview.exportSlidesMarkdown",
        "title": "VFM: Export Slides as Markdown…"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vfmPreview.openToSide",
          "when": "editorLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "vfmPreview.showSlides",
          "when": "activeWebviewPanelId == 'vfmPreview' && vfmPreview.mode == 'document'",
          "group": "navigation"
        },
        {
          "command": "vfmPreview.showDocument",
          "when": "activeWebviewPanelId == 'vfmPreview' && vfmPreview.mode == 'slides'",
          "group": "navigation"
        },
        {
          "command": "vfmPreview.openInBrowser",
          "when": "activeWebviewPanelId == 'vfmPreview'",
          "group": "navigation"
        },
        {
          "command": "vfmPreview.exportHtml",
          "when": "(editorLangId == markdown || activeWebviewPanelId == 'vfmPreview')",
          "group": "1_export@1"
        },
        {
          "command": "vfmPreview.exportPdf",
          "when": "(editorLangId == markdown || activeWebviewPanelId == 'vfmPreview')",
          "group": "1_export@2"
        }
      ],
      "explorer/context": [
        {
          "command": "vfmPreview.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "vfmPreview.openInBrowser",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vfmPreview.exportHtml",
          "when": "(editorLangId == markdown || activeWebviewPanelId == 'vfmPreview')"
        },
        {
          "command": "vfmPreview.exportPdf",
          "when": "(editorLangId == markdown || activeWebviewPanelId == 'vfmPreview')"
        },
        {
          "command": "vfmPreview.openInBrowser",
          "when": "(editorLangId == markdown || activeWebviewPanelId == 'vfmPreview')"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vfmPreview.openToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdown"
      },
      {
        "command": "vfmPreview.toggleMode",
        "key": "ctrl+k m",
        "mac": "cmd+k m",
        "when": "editorLangId == markdown || activeWebviewPanelId == 'vfmPreview'"
      }
    ],
    "configuration": {
      "title": "VFM Preview",
      "properties": {
        "vfmPreview.numberingDepth": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Heading depth for section numbers. 0 disables heading numbering."
        },
        "vfmPreview.numberCaptions": {
          "type": "string",
          "enum": [
            "referenced",
            "all"
          ],
          "enumDescriptions": [
            "Number only the figures, tables, listings, equations, algorithms and scores that a cross-reference points to. The others keep their caption without a number.",
            "Number every captioned or labelled figure, table, listing, equation, algorithm and score."
          ],
          "default": "referenced",
          "description": "Document mode (and Word export): which captions get a number."
        },
        "vfmPreview.theme": {
          "type": "string",
          "enum": [
            "vfm",
            "vscode"
          ],
          "enumDescriptions": [
            "Use vfm's own light and dark palettes, chosen by whether the VS Code theme is light or dark.",
            "Inherit colors from the active VS Code color theme."
          ],
          "default": "vfm",
          "description": "Color theme of the preview."
        },
        "vfmPreview.maxWidth": {
          "type": "number",
          "default": 860,
          "description": "Maximum width of the rendered document, in pixels. 0 for no limit."
        },
        "vfmPreview.mode": {
          "type": "string",
          "enum": [
            "document",
            "slides"
          ],
          "enumDescriptions": [
            "Render the whole document.",
            "Render only the @slide blocks, as a slideshow."
          ],
          "default": "document",
          "description": "Mode a new preview opens in. Switch an open preview with the VFM: Toggle Document / Slide Mode command."
        },
        "vfmPreview.maxHeadingsPerSlide": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Slide mode: warn when a content slide holds more headings than this."
        },
        "vfmPreview.browserPath": {
          "type": "string",
          "default": "",
          "description": "Chrome, Chromium, Edge or Brave executable used for PDF export. Empty: look in the usual places."
        },
        "vfmPreview.allowRemoteImages": {
          "type": "boolean",
          "default": false,
          "description": "Allow the preview to load images and videos from http(s) URLs in the Markdown. Off by default so the preview makes no network requests."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && npx @vscode/vsce package --allow-missing-repository --skip-license",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "abcjs": "^6.7.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-markdown": "^2.2.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.0.0",
    "micromark-util-types": "^2.0.3",
    "pseudocode": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype": "^13.0.2",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}