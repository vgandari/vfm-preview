{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@vfm": ["node_modules/vfm/index.tsx"],
      "@vfm/*": ["node_modules/vfm/*"],
      "*": ["node_modules/@types/*", "node_modules/*"]
    }
  },
  "include": ["src"]
}
